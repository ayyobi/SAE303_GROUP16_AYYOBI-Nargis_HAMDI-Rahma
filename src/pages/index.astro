---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ClimateContext from "../components/ClimateContext.astro";
import ClimateDefinitions from "../components/ClimateDefinitions.astro";
import DataSources from "../components/DataSources.astro";
import NextChapter from "../components/NextChapter.astro";
import TemperatureDistribution from "../components/charts/TemperatureDistribution.astro";
import BesanconLCZMap from "../components/maps/BesanconLCZMap.astro";
import HeatTrends from "../components/charts/HeatTrends.astro";
import HeatThresholdExplorer from "../components/charts/HeatThresholdExplorer.astro";
import Climate2050 from "../components/Climate2050.astro";
import UrbanAdaptation from "../components/UrbanAdaptation.astro";
import ClimateConclusion from "../components/ClimateConclusion.astro";
const axes = [
  { number: "01", title: "Les relevés météo", text: "Nous regardons les observations de Météo-France entre 1959 et 2022 pour suivre les températures et compter les journées chaudes." },
  { number: "02", title: "La forme de la ville", text: "La carte du Cerema nous permet de situer le bâti, la végétation et les sols imperméables dans un secteur central de Besançon." },
  { number: "03", title: "Les perspectives 2050", text: "Nous présentons ensuite les projections Climadiag, séparément des observations, pour ouvrir la réflexion sur l’adaptation." },
];
---

<Layout>
  <Hero />
  <section id="introduction" class="introduction" aria-labelledby="intro-title"><div class="shell">
    <div class="section-heading"><p class="eyebrow">Pourquoi nous avons choisi ce sujet</p><span class="section-number" aria-hidden="true">01 /</span></div>
    <div class="intro-grid"><h2 id="intro-title">Notre point de départ : <em>Besançon.</em></h2><div class="intro-text"><p>Nous voulions comprendre comment les journées chaudes évoluent dans une ville précise. Les données de Besançon nous permettent de suivre plusieurs décennies et de relier cette lecture à la question des espaces urbains.</p><p class="research-question">Notre question : <strong>Comment les fortes chaleurs ont-elles évolué à Besançon, et comment l'analyse des espaces urbains peut-elle aider la ville à s'adapter ?</strong></p></div></div>
    <div class="journey-heading"><h3>Comment nous avons abordé la question</h3><span>Trois sources, trois lectures complémentaires</span></div>
    <ul class="journey-grid">{axes.map(axis => <li><span class="step-number" aria-hidden="true">{axis.number}</span><h4>{axis.title}</h4><p>{axis.text}</p></li>)}</ul>
  </div></section>
  <ClimateContext />
  <ClimateDefinitions />
  <DataSources />
  <NextChapter />
  <TemperatureDistribution />
  <BesanconLCZMap />
  <HeatTrends />
  <HeatThresholdExplorer />
  <Climate2050 />
  <UrbanAdaptation />
  <ClimateConclusion />
</Layout>
